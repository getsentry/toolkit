---
// Browsers that open /install are rewritten here (see the Vercel config in
// .github/workflows/cli-build.yml); curl and wget still get the raw script.
import { createHash } from "node:crypto";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Code } from "@astrojs/starlight/components";
import script from "../../public/install?raw";

const sha256 = createHash("sha256").update(script).digest("hex");
---

<StarlightPage frontmatter={{ title: "Install script", pagefind: false }}>
  <p>
    This is the script that <code>curl https://cli.sentry.dev/install -fsS | bash</code> runs.
    Its SHA-256 is <code>{sha256}</code>. Check that what you download matches with
    <code>curl -fsS https://cli.sentry.dev/install | shasum -a 256</code>, or read
    the <a href="https://github.com/getsentry/toolkit/blob/main/packages/cli/install">source on GitHub</a>.
  </p>
  <Code code={script} lang="bash" title="install" />
</StarlightPage>
