{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs-mcp",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-02-26",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "execa": "./src/stubs/execa.ts",
  },
  "upload_source_maps": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "observability": {
    "logs": {
      "enabled": true,
    },
  },
  "dev": {
    "inspector_port": 9230,
  },
}
