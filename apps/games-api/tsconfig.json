{
  "extends": "@sentry/mcp-server-tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    // Exception to the shared skipLibCheck: false policy.
    // @sentry/cloudflare pulls in @sentry/server-utils, whose declarations
    // reference Node types (node:async_hooks, node:diagnostics_channel,
    // Buffer) and fail with TS2591 without @types/node. Adding @types/node
    // instead collides with @cloudflare/workers-types globals (TS2300,
    // TS2451). Remove once @sentry/cloudflare's declarations type-check
    // against Workers types alone, or once @types/node and the Workers
    // runtime types can share a program.
    "skipLibCheck": true
  },
  "include": ["src"]
}
