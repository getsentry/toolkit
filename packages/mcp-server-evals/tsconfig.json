{
  "extends": "@sentry/mcp-server-tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    // msw and the AI SDK declarations use Fetch and WebSocket DOM types
    // (ResponseType, HeadersInit, EventInit, ...) that @types/node lacks.
    "lib": ["ES2023", "ES2024.String", "DOM"],
    "types": ["node"],
    // Exception to the shared policy: the `ai` package's declarations fail
    // their own check under exactOptionalPropertyTypes (TS2344 in
    // ai/dist/index.d.ts, e.g. "Type 'TOOLS[NAME]' does not satisfy the
    // constraint 'Tool<any, any>'"), in 6.0.64 through 7.0.173. Remove this
    // when `ai` type-checks with skipLibCheck off.
    "skipLibCheck": true
  },
  "include": ["src"]
}
