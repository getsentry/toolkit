{
  "extends": "@sentry/mcp-server-tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    // msw and the AI SDK declarations use Fetch and WebSocket DOM types
    // (ResponseType, HeadersInit, EventInit, ...) that @types/node lacks.
    "lib": ["ES2023", "ES2024.String", "DOM"],
    "types": ["node"],
    // skipLibCheck exception: `ai` declarations fail TS2344 under exactOptionalPropertyTypes (ai@6.0.x dist/index.d.ts). Remove when they check cleanly.
    "skipLibCheck": true
  },
  "include": ["src"]
}
