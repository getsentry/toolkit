{
  "extends": "@sentry/mcp-server-tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Lets tsdown emit declarations with Oxc instead of the compiler API.
    "allowJs": false,
    "isolatedDeclarations": true
  },
  "include": ["src"]
}
