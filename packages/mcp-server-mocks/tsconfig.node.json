{
  // Build tooling that runs in Node and is not part of the published package.
  // Kept out of tsconfig.json, whose rootDir and isolatedDeclarations apply
  // to the emitted src/ declarations only.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "ES2024.String"],
    "allowJs": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["tsdown.config.ts"]
}
