{
  "name": "@sentry/mcp-server",
  "mcpName": "io.github.getsentry/sentry-mcp",
  "version": "0.48.0-dev.0",
  "description": "Sentry MCP server over stdio: the CLI's `sentry mcp` server, bundled without the rest of the CLI",
  "sentryCi": {
    "build": "bundle",
    "test": "test:bundle",
    "dependencies": [
      "sentry"
    ]
  },
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "FSL-1.1-ALv2",
  "author": "Sentry",
  "homepage": "https://github.com/getsentry/toolkit",
  "keywords": [
    "sentry",
    "mcp",
    "model-context-protocol"
  ],
  "bugs": {
    "url": "https://github.com/getsentry/toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsentry/toolkit.git"
  },
  "bin": {
    "sentry-mcp": "./dist/sentry-mcp.cjs"
  },
  "files": [
    "dist/sentry-mcp.cjs"
  ],
  "scripts": {
    "bundle": "pnpm --filter @sentry/mcp-core run build && pnpm --filter sentry run generate:schema && pnpm --filter sentry run generate:docs && pnpm --filter sentry run generate:sdk && tsx script/bundle.ts",
    "test:bundle": "node --test test/bundle.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "catalog:"
  }
}
