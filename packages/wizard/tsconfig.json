{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  // The package ships its bin script as written, with no build step.
  "include": ["bin", "test"]
}
