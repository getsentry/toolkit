{
  "name": "@sentry/toolkit-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    "./events-fields": {
      "types": "./src/events-fields.ts",
      "default": "./src/events-fields.ts"
    },
    "./events-sort": {
      "types": "./src/events-sort.ts",
      "default": "./src/events-sort.ts"
    },
    "./metric-monitor": {
      "types": "./src/metric-monitor.ts",
      "default": "./src/metric-monitor.ts"
    },
    "./games": {
      "types": "./src/games.ts",
      "default": "./src/games.ts"
    },
    "./mcp-limits": {
      "types": "./src/mcp-limits.ts",
      "default": "./src/mcp-limits.ts"
    },
    "./oauth-device": {
      "types": "./src/oauth-device.ts",
      "default": "./src/oauth-device.ts"
    },
    "./oauth-poll": {
      "types": "./src/oauth-poll.ts",
      "default": "./src/oauth-poll.ts"
    },
    "./region-cache": {
      "types": "./src/region-cache.ts",
      "default": "./src/region-cache.ts"
    },
    "./resource-identity": {
      "types": "./src/resource-identity.ts",
      "default": "./src/resource-identity.ts"
    },
    "./response-cache/codec": {
      "types": "./src/response-cache/codec.ts",
      "default": "./src/response-cache/codec.ts"
    },
    "./search-query": {
      "types": "./src/search-query.ts",
      "default": "./src/search-query.ts"
    },
    "./sentry-host": {
      "types": "./src/sentry-host.ts",
      "default": "./src/sentry-host.ts"
    },
    "./sentry-origin": {
      "types": "./src/sentry-origin.ts",
      "default": "./src/sentry-origin.ts"
    },
    "./markdown": {
      "types": "./src/markdown.ts",
      "default": "./src/markdown.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=tests.junit.xml",
    "tsc": "tsc --noEmit && tsc -p tsconfig.browser.json"
  },
  "dependencies": {
    "@sentry/api": "catalog:",
    "@sentry/search-syntax": "catalog:"
  },
  "devDependencies": {
    "fast-check": "^4.8.0",
    "marked": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
