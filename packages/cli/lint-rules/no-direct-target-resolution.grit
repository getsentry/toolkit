language js

// CLI commands resolve project/org targets through capability helpers in
// resolve-target.ts. Calling the low-level search or miss classifier directly
// lets command-specific precedence drift.
//
// issue/utils.ts is intentionally excluded: it uses project lookup while
// resolving issue IDs, not CLI target syntax.
file($name, $body) where {
  $name <: r".*src/commands/.*",
  $name <: not r".*src/commands/issue/utils\.ts$",
  $body <: contains or {
    `findProjectsBySlug($args)` as $match,
    `$api.findProjectsBySlug($args)` as $match,
    `triageProjectNotFound($args)` as $match,
    `$resolver.triageProjectNotFound($args)` as $match
  },
  register_diagnostic(span=$match, message="Use a capability helper from resolve-target.ts instead of low-level project target resolution (AGENTS.md).")
}
