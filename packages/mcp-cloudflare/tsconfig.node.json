{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2023", "ES2024.String"],
    "allowJs": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "outDir": "dist",
    "rootDir": ""
  },
  "include": ["vite.config.ts"]
}
