{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.getsentry/sentry-mcp",
  "description": "MCP server for Sentry - error monitoring, issue tracking, and debugging for AI assistants",
  "repository": {
    "url": "https://github.com/getsentry/toolkit",
    "source": "github",
    "subfolder": "packages/cli"
  },
  "version": "0.48.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "sentry",
      "version": "0.48.0",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }],
      "environmentVariables": [
        {
          "description": "Sentry user auth token. Optional when you have run `sentry auth login`.",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "SENTRY_ACCESS_TOKEN"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.sentry.dev/mcp"
    }
  ]
}
