{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Shared type-checking policy for every first-party TypeScript project.
  // Projects extend this and set only their runtime: module resolution, lib,
  // ambient types, JSX, and emit. Do not weaken these options in a project;
  // scripts/tsconfig-policy.test.mjs fails when a project does.
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": false
  }
}
